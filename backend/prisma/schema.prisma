generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  slug                   String                 @unique(map: "uq_colleges_slug")
  code                   String?                @unique(map: "uq_colleges_code")
  officialEmail          String?                @map("official_email")
  address                String?
  city                   String?
  state                  String?
  contactNumber          String?                @map("contact_number")
  isActive               Boolean                @default(true) @map("is_active")
  studentEmailDomain     String?                @map("student_email_domain")
  studentEmailPattern    String?                @map("student_email_pattern")
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  club_departments       ClubDepartment[]
  clubs                  Club[]
  deletion_verifications DeletionVerification[]
  departments            Department[]
  event_gallery_images   EventGalleryImage[]
  event_registrations    EventRegistration[]
  events                 Event[]
  memberships            Membership[]
  users                  User[]
  studentActivations     StudentActivation[]
  emailOutbox            EmailOutbox[]
  certificates           EventCertificate[]
  certificateTemplates   EventCertificateTemplate[]
  certificateBatches     CertificateBatch[]
  externalParticipants   ExternalParticipant[]
  seatReservations       SeatReservation[]
  collegePaymentConfig   CollegePaymentConfig?
  paymentTransactions    PaymentTransaction[]
  paymentRefunds         PaymentRefund[]
  paymentWebhookEvents   PaymentWebhookEvent[]
  attendedRegistrations  EventRegistration[]        @relation("StudentHomeCollege")
  externalAuthOtps       ExternalAuthOtp[]

  @@map("colleges")
}

model PlatformAdmin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  totpSecret   String?  @map("totp_secret")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_admins")
}

model User {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId                 String                 @map("college_id") @db.Uuid
  name                      String
  email                     String                 @db.Citext
  passwordHash              String?                @map("password_hash")
  role                      UserRole               @default(USER)
  isActive                  Boolean                @default(false) @map("is_active")
  inviteTokenHash           String?                @map("invite_token_hash")
  inviteExpiresAt           DateTime?              @map("invite_expires_at") @db.Timestamptz(6)
  passwordResetOtpHash      String?                @map("password_reset_otp_hash")
  passwordResetOtpExpiresAt DateTime?              @map("password_reset_otp_expires_at") @db.Timestamptz(6)
  passwordResetAttempts     Int                    @default(0) @map("password_reset_attempts")
  avatarUrl                 String?                @map("avatar_url")
  avatarPublicId            String?                @map("avatar_public_id")
  legacyMongoId             String?                @unique @map("legacy_mongo_id")
  rollNumber                String?                @map("roll_number") @db.Citext
  departmentId              String?                @map("department_id") @db.Uuid
  admissionYear             Int?                   @map("admission_year")
  phone                     String?                @map("phone")
  gender                    String?                @map("gender")
  yearOfStudy               String?                @map("year_of_study")
  section                   String?                @map("section")
  claimedAt                 DateTime?              @map("claimed_at") @db.Timestamptz(6)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdClubs              Club[]                 @relation("ClubCreator")
  deletionVerifications     DeletionVerification[] @relation("DeletionVerificationAdmin")
  eventRegistrations        EventRegistration[]
  memberships               Membership[]
  studentActivations        StudentActivation[]
  certificates              EventCertificate[]     @relation("UserCertificates")
  issuedCertificates        EventCertificate[]     @relation("IssuedCertificates")
  revokedCertificates       EventCertificate[]     @relation("RevokedCertificates")
  createdCertificateTemplates EventCertificateTemplate[]
  createdCertificateBatches CertificateBatch[]
  seatReservations          SeatReservation[]
  paymentTransactions       PaymentTransaction[]
  adminRegistrations        EventRegistration[]    @relation("AdminRegistrations")
  college                   College                @relation(fields: [collegeId], references: [id], onUpdate: NoAction, map: "users_college_id_fkey")
  department                Department?            @relation(fields: [collegeId, departmentId], references: [collegeId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_department")

  @@unique([collegeId, email], map: "uq_users_college_email")
  @@unique([collegeId, id], map: "uq_users_college_id")
  @@unique([collegeId, rollNumber], map: "uq_users_college_roll_number")
  @@index([collegeId, isActive], map: "idx_users_college_active")
  @@map("users")
}

model Department {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId     String           @map("college_id") @db.Uuid
  name          String
  shortCode     String           @map("short_code")
  description   String?
  legacyMongoId String?          @unique @map("legacy_mongo_id")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  clubs         ClubDepartment[]
  users         User[]
  college       College          @relation(fields: [collegeId], references: [id], onUpdate: NoAction, map: "departments_college_id_fkey")

  @@unique([collegeId, name], map: "uq_departments_college_name")
  @@unique([collegeId, shortCode], map: "uq_departments_college_short_code")
  @@unique([collegeId, id], map: "uq_departments_college_id")
  @@map("departments")
}

model Club {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId          String           @map("college_id") @db.Uuid
  name               String
  description        String?
  clubType           ClubType         @default(DEPARTMENTAL) @map("club_type")
  logoUrl            String?          @map("logo_url")
  logoPublicId       String?          @map("logo_public_id")
  coverImageUrl      String?          @map("cover_image_url")
  coverImagePublicId String?          @map("cover_image_public_id")
  createdByUserId    String           @map("created_by_user_id") @db.Uuid
  legacyMongoId      String?          @unique @map("legacy_mongo_id")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  departments        ClubDepartment[]
  college            College          @relation(fields: [collegeId], references: [id], onUpdate: NoAction, map: "clubs_college_id_fkey")
  createdBy          User             @relation("ClubCreator", fields: [collegeId, createdByUserId], references: [collegeId, id], onUpdate: NoAction, map: "fk_clubs_creator")
  events             Event[]
  members            Membership[]

  @@unique([collegeId, name], map: "uq_clubs_college_name")
  @@unique([collegeId, id], map: "uq_clubs_college_id")
  @@index([collegeId, createdAt(sort: Desc)], map: "idx_clubs_college_created")
  @@index([collegeId, clubType], map: "idx_clubs_college_type")
  @@map("clubs")
}

model ClubDepartment {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId     String     @map("college_id") @db.Uuid
  clubId        String     @map("club_id") @db.Uuid
  departmentId  String     @map("department_id") @db.Uuid
  legacyMongoId String?    @unique @map("legacy_mongo_id")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  colleges      College    @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  club          Club       @relation(fields: [collegeId, clubId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_club_departments_club")
  department    Department @relation(fields: [collegeId, departmentId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_club_departments_dept")

  @@unique([clubId, departmentId], map: "uq_club_departments_pair")
  @@unique([collegeId, id], map: "uq_club_departments_college_id")
  @@index([collegeId, departmentId], map: "idx_club_departments_college_dept")
  @@map("club_departments")
}

model Membership {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId     String         @map("college_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  clubId        String         @map("club_id") @db.Uuid
  role          MembershipRole @default(MEMBER)
  legacyMongoId String?        @unique @map("legacy_mongo_id")
  joinedAt      DateTime       @default(now()) @map("joined_at") @db.Timestamptz(6)
  club          Club           @relation(fields: [collegeId, clubId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_memberships_club")
  user          User           @relation(fields: [collegeId, userId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_memberships_user")
  colleges      College        @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, clubId], map: "uq_memberships_user_club")
  @@unique([collegeId, id], map: "uq_memberships_college_id")
  @@index([collegeId, clubId, role], map: "idx_memberships_college_club_role")
  @@index([collegeId, userId], map: "idx_memberships_college_user")
  @@map("memberships")
}

model Event {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId            String                 @map("college_id") @db.Uuid
  clubId               String                 @map("club_id") @db.Uuid
  title                String
  description          String
  location             String
  startAt              DateTime               @map("start_at") @db.Timestamptz(6)
  endAt                DateTime?              @map("end_at") @db.Timestamptz(6)
  cancelledAt          DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  capacity             Int?
  registeredCount      Int                    @default(0) @map("registered_count")
  coverImageUrl        String?                @map("cover_image_url")
  coverImagePublicId   String?                @map("cover_image_public_id")
  registrationUrl      String?                @map("registration_url")
  registrationMode     EventRegistrationMode  @default(INTERNAL) @map("registration_mode")
  customFormDefinition Json?                  @map("custom_form_definition")
  registrationDeadline DateTime?              @map("registration_deadline") @db.Timestamptz(6)
  visibility           EventVisibility        @default(COLLEGE)
  isPaid               Boolean                @default(false) @map("is_paid")
  fee                  Int                    @default(0)
  currency             String                 @default("INR")
  legacyMongoId        String?                @unique @map("legacy_mongo_id")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  gallery              EventGalleryImage[]
  registrations        EventRegistration[]
  certificates         EventCertificate[]
  certificateTemplates EventCertificateTemplate[]
  certificateBatches   CertificateBatch[]
  seatReservations     SeatReservation[]
  paymentTransactions  PaymentTransaction[]
  colleges             College                @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  club                 Club                   @relation(fields: [collegeId, clubId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_events_club")

  @@unique([collegeId, id], map: "uq_events_college_id")
  @@index([collegeId, startAt], map: "idx_events_college_start_at")
  @@index([collegeId, clubId, startAt(sort: Desc)], map: "idx_events_college_club_start")
  @@map("events")
}

model EventGalleryImage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId     String   @map("college_id") @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  imageUrl      String   @map("image_url")
  imagePublicId String   @map("image_public_id")
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  colleges      College  @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  event         Event    @relation(fields: [collegeId, eventId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_event_gallery_event")

  @@unique([eventId, imagePublicId], map: "uq_event_gallery_event_public_id")
  @@index([collegeId, eventId, position], map: "idx_event_gallery_college_event_pos")
  @@map("event_gallery_images")
}

model EventRegistration {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId              String              @map("college_id") @db.Uuid
  eventId                String              @map("event_id") @db.Uuid
  userId                 String?             @map("user_id") @db.Uuid
  participantType        ParticipantType     @default(STUDENT) @map("participant_type")
  homeCollegeId          String?             @map("home_college_id") @db.Uuid
  externalParticipantId   String?             @map("external_participant_id") @db.Uuid
  paymentTransactionId   String?             @unique @map("payment_transaction_id") @db.Uuid
  participantName        String              @map("participant_name")
  participantEmail       String              @map("participant_email")
  participantRollNumber  String?             @map("participant_roll_number")
  participantCollegeName String?             @map("participant_college_name")
  participantDepartment  String?             @map("participant_department")
  participantGender      String?             @map("participant_gender")
  participantYearOfStudy String?             @map("participant_year_of_study")
  participantPhone       String?             @map("participant_phone")
  isUserDeleted          Boolean             @default(false) @map("is_user_deleted")
  registeredByRole       String              @default("SELF") @map("registered_by_role")
  createdByAdminId       String?             @map("created_by_admin_id") @db.Uuid
  formAnswers            Json?               @map("form_answers")
  registeredAt           DateTime            @default(now()) @map("registered_at") @db.Timestamptz(6)
  colleges               College             @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  event                  Event               @relation(fields: [collegeId, eventId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_registrations_event")
  user                   User?               @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_registrations_user_direct")
  homeCollege            College?            @relation("StudentHomeCollege", fields: [homeCollegeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_registrations_home_college")
  externalParticipant    ExternalParticipant? @relation(fields: [collegeId, externalParticipantId], references: [collegeId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_registrations_external_participant")
  paymentTransaction     PaymentTransaction? @relation(fields: [collegeId, paymentTransactionId], references: [collegeId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_registrations_payment_transaction")
  createdByAdmin         User?               @relation("AdminRegistrations", fields: [createdByAdminId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_registrations_created_by_admin")

  @@unique([userId, eventId], map: "uq_event_registrations_user_event")
  @@unique([externalParticipantId, eventId], map: "uq_event_registrations_external_event")
  @@unique([collegeId, paymentTransactionId], map: "uq_event_registrations_college_payment_txn")
  @@index([collegeId, eventId], map: "idx_event_registrations_college_event")
  @@index([collegeId, userId], map: "idx_event_registrations_college_user")
  @@index([externalParticipantId, eventId], map: "idx_event_registrations_external_event")
  @@map("event_registrations")
}

model StudentActivation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId   String   @map("college_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  codeHash    String   @map("code_hash")
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  consumed    Boolean  @default(false)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  college College @relation(fields: [collegeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_student_activations_college")
  user    User    @relation(fields: [collegeId, userId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_student_activations_user")

  @@index([collegeId, userId, consumed, expiresAt], map: "idx_student_activations_candidate")
  @@map("student_activations")
}

model EmailOutbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId     String    @map("college_id") @db.Uuid
  recipientEmail String   @map("recipient_email")
  recipientName String    @map("recipient_name")
  templateType  String    @map("template_type")
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3) @map("max_attempts")
  claimToken    String?   @map("claim_token") @db.Uuid
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  errorMessage  String?   @map("error_message")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  college College @relation(fields: [collegeId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, expiresAt, lockedUntil], map: "idx_email_outbox_queue")
  @@map("email_outbox")
}

model DeletionVerification {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId  String         @map("college_id") @db.Uuid
  adminId    String         @map("admin_id") @db.Uuid
  targetType DeletionTarget @map("target_type")
  targetId   String         @map("target_id") @db.Uuid
  codeHash   String         @map("code_hash")
  expiresAt  DateTime       @map("expires_at") @db.Timestamptz(6)
  consumed   Boolean        @default(false)
  attempts   Int            @default(0)
  maxAttempts Int           @default(5) @map("max_attempts")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  colleges   College        @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admin      User           @relation("DeletionVerificationAdmin", fields: [collegeId, adminId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_del_verif_admin")

  @@map("deletion_verifications")
}

// NOTE: SQL migrations (001_init.sql / 002_rls.sql) own this view definition.
// Prisma must never create, alter, or manage this view. It is declared here
// as a read-only view model for type generation and querying via Prisma Client.
view EventsWithStatus {
  id                 String    @unique @db.Uuid
  collegeId          String    @map("college_id") @db.Uuid
  clubId             String    @map("club_id") @db.Uuid
  title              String
  description        String
  location           String
  startAt            DateTime  @map("start_at") @db.Timestamptz(6)
  endAt              DateTime? @map("end_at") @db.Timestamptz(6)
  capacity           Int?
  registeredCount    Int       @map("registered_count")
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  coverImageUrl      String?   @map("cover_image_url")
  coverImagePublicId String?   @map("cover_image_public_id")
  registrationUrl    String?   @map("registration_url")
  legacyMongoId      String?   @map("legacy_mongo_id")
  createdAt             DateTime              @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @map("updated_at") @db.Timestamptz(6)
  status                String
  registrationMode      EventRegistrationMode @default(INTERNAL) @map("registration_mode")
  customFormDefinition  Json?                 @map("custom_form_definition")
  registrationDeadline  DateTime?             @map("registration_deadline") @db.Timestamptz(6)
  visibility            EventVisibility       @default(COLLEGE)
  isPaid                Boolean               @default(false) @map("is_paid")
  fee                   Int                   @default(0)
  currency              String                @default("INR")

  @@map("events_with_status")
}

enum ClubType {
  CENTRAL
  DEPARTMENTAL

  @@map("club_type_enum")
}

enum UserRole {
  COLLEGE_ADMIN
  USER

  @@map("user_role_enum")
}

enum MembershipRole {
  MANAGER
  MEMBER

  @@map("membership_role_enum")
}

enum DeletionTarget {
  USER
  CLUB

  @@map("deletion_target_enum")
}

enum EventRegistrationMode {
  INTERNAL
  EXTERNAL
  NONE

  @@map("event_registration_mode_enum")
}

model CertificateBatch {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId    String                 @map("college_id") @db.Uuid
  eventId      String                 @map("event_id") @db.Uuid
  method       CertificateBatchMethod
  status       CertificateBatchStatus @default(PENDING)
  totalCount   Int                    @default(0) @map("total_count")
  successCount Int                    @default(0) @map("success_count")
  failedCount  Int                    @default(0) @map("failed_count")
  skippedCount Int                    @default(0) @map("skipped_count")
  errorDetails Json                   @default("[]") @map("error_details")
  createdById  String                 @map("created_by_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  college      College                @relation(fields: [collegeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  event        Event                  @relation(fields: [collegeId, eventId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_batches_event")
  creator      User                   @relation(fields: [collegeId, createdById], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_batches_creator")
  certificates EventCertificate[]

  @@unique([collegeId, id], map: "uq_certificate_batches_college_id")
  @@index([collegeId, eventId], map: "idx_certificate_batches_event")
  @@map("certificate_batches")
}

model EventCertificateTemplate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId         String   @map("college_id") @db.Uuid
  eventId           String   @map("event_id") @db.Uuid
  templateName      String   @map("template_name")
  templatePublicId  String   @map("template_public_id")
  templateUrl       String   @map("template_url")
  placeholderConfig Json     @default("[]") @map("placeholder_config")
  isActive          Boolean  @default(true) @map("is_active")
  createdById       String   @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  college           College  @relation(fields: [collegeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  event             Event    @relation(fields: [collegeId, eventId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cert_templates_event")
  creator           User     @relation(fields: [collegeId, createdById], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cert_templates_creator")

  @@index([collegeId, eventId], map: "idx_cert_templates_event")
  @@map("event_certificate_templates")
}

model EventCertificate {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId           String            @map("college_id") @db.Uuid
  eventId             String            @map("event_id") @db.Uuid
  userId              String?           @map("user_id") @db.Uuid
  certificateNumber   String            @unique @map("certificate_number")
  certificatePublicId String?           @map("certificate_public_id")
  certificateUrl      String?           @map("certificate_url")
  source              CertificateSource @default(INDIVIDUAL_UPLOAD)
  status              CertificateStatus @default(ISSUED)
  issuedAt            DateTime          @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById          String?           @map("issued_by_id") @db.Uuid
  revokedAt           DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokedById         String?           @map("revoked_by_id") @db.Uuid
  revocationReason    String?           @map("revocation_reason")
  batchId             String?           @map("batch_id") @db.Uuid
  metadata            Json?             @default("{}")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  college             College           @relation(fields: [collegeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  event               Event             @relation(fields: [collegeId, eventId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_certificates_event")
  user                User?             @relation("UserCertificates", fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_certificates_user")
  batch               CertificateBatch? @relation(fields: [collegeId, batchId], references: [collegeId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_certificates_batch")
  issuedBy            User?             @relation("IssuedCertificates", fields: [collegeId, issuedById], references: [collegeId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_certificates_issuer")
  revokedBy           User?             @relation("RevokedCertificates", fields: [collegeId, revokedById], references: [collegeId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_certificates_revoker")

  @@index([collegeId, eventId], map: "idx_event_certificates_college_event")
  @@index([collegeId, userId], map: "idx_event_certificates_college_user")
  @@index([collegeId, status], map: "idx_event_certificates_status")
  @@map("event_certificates")
}

enum CertificateSource {
  INDIVIDUAL_UPLOAD
  BULK_UPLOAD
  GENERATED

  @@map("certificate_source_enum")
}

enum CertificateStatus {
  ISSUED
  REVOKED

  @@map("certificate_status_enum")
}

enum CertificateBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED

  @@map("certificate_batch_status_enum")
}

enum CertificateBatchMethod {
  BULK_UPLOAD
  GENERATED

  @@map("certificate_batch_method_enum")
}

enum EventVisibility {
  COLLEGE
  PUBLIC

  @@map("event_visibility_enum")
}

enum ParticipantType {
  STUDENT
  EXTERNAL

  @@map("participant_type_enum")
}

enum CollegePaymentMode {
  COLLEGE_OWNED_GATEWAY
  PLATFORM_MANAGED_GATEWAY

  @@map("college_payment_mode_enum")
}

enum PaymentGatewayProvider {
  RAZORPAY
  CASHFREE

  @@map("payment_gateway_provider_enum")
}

enum PaymentConfigStatus {
  NOT_CONFIGURED
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED

  @@map("payment_config_status_enum")
}

enum SeatReservationStatus {
  HELD
  CONFIRMED
  EXPIRED
  RELEASED

  @@map("seat_reservation_status_enum")
}

enum TransactionPaymentStatus {
  PENDING
  PAID
  FAILED
  LATE_PAYMENT
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("transaction_payment_status_enum")
}

enum RefundStatus {
  INITIATED
  PROCESSED
  FAILED

  @@map("refund_status_enum")
}

enum WebhookProcessStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED

  @@map("webhook_process_status_enum")
}

model ExternalParticipant {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId       String              @map("college_id") @db.Uuid
  name            String
  email           String              @db.Citext
  phone           String?
  institutionName String?             @map("institution_name")
  rollNumber      String?             @map("roll_number")
  department      String?             @map("department")
  gender          String?             @map("gender")
  yearOfStudy     String?             @map("year_of_study")
  isEmailVerified Boolean             @default(false) @map("is_email_verified")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  college         College             @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  registrations   EventRegistration[]
  seatReservations SeatReservation[]
  transactions    PaymentTransaction[]

  @@unique([collegeId, id], map: "uq_external_participants_college_id")
  @@unique([collegeId, email], map: "uq_external_participants_college_email")
  @@index([collegeId], map: "idx_external_participants_college")
  @@map("external_participants")
}

model SeatReservation {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId             String                @map("college_id") @db.Uuid
  eventId               String                @map("event_id") @db.Uuid
  participantType       ParticipantType       @map("participant_type")
  userId                String?               @map("user_id") @db.Uuid
  externalParticipantId String?               @map("external_participant_id") @db.Uuid
  status                SeatReservationStatus @default(HELD)
  expiresAt             DateTime              @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  college               College               @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  event                 Event                 @relation(fields: [collegeId, eventId], references: [collegeId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_seat_reservations_event")
  user                  User?                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_seat_reservations_user")
  externalParticipant   ExternalParticipant?  @relation(fields: [collegeId, externalParticipantId], references: [collegeId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_seat_reservations_external_participant")
  paymentTransaction    PaymentTransaction?

  @@unique([collegeId, id], map: "uq_seat_reservations_college_id")
  @@index([eventId, status, expiresAt], map: "idx_seat_reservations_capacity")
  @@index([collegeId, userId], map: "idx_seat_reservations_college_user")
  @@map("seat_reservations")
}

model CollegePaymentConfig {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId                  String                 @unique @map("college_id") @db.Uuid
  mode                       CollegePaymentMode     @default(COLLEGE_OWNED_GATEWAY)
  provider                   PaymentGatewayProvider @default(RAZORPAY)
  status                     PaymentConfigStatus    @default(NOT_CONFIGURED)
  isTestMode                 Boolean                @default(true) @map("is_test_mode")
  keyIdEncrypted             String?                @map("key_id_encrypted")
  keySecretEncrypted         String?                @map("key_secret_encrypted")
  webhookSecretEncrypted     String?                @map("webhook_secret_encrypted")
  merchantAccountIdEncrypted String?                @map("merchant_account_id_encrypted")
  displayMerchantName        String?                @map("display_merchant_name")
  verifiedAt                 DateTime?              @map("verified_at") @db.Timestamptz(6)
  credentialsRotatedAt       DateTime?              @map("credentials_rotated_at") @db.Timestamptz(6)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  college                    College                @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  audits                     CollegePaymentConfigAudit[]

  @@map("college_payment_configs")
}

model CollegePaymentConfigAudit {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configId            String                  @map("config_id") @db.Uuid
  collegeId           String                  @map("college_id") @db.Uuid
  changedByAdminId    String                  @map("changed_by_admin_id") @db.Uuid
  previousMode        CollegePaymentMode?     @map("previous_mode")
  newMode             CollegePaymentMode      @map("new_mode")
  previousStatus      PaymentConfigStatus?    @map("previous_status")
  newStatus           PaymentConfigStatus     @map("new_status")
  previousProvider    PaymentGatewayProvider? @map("previous_provider")
  newProvider         PaymentGatewayProvider? @map("new_provider")
  previousIsTestMode  Boolean?                @map("previous_is_test_mode")
  newIsTestMode       Boolean?                @map("new_is_test_mode")
  credentialsRotated  Boolean                 @default(false) @map("credentials_rotated")
  keyIdPreview        String?                 @map("key_id_preview")
  changeReason        String?                 @map("change_reason")
  ipAddress           String?                 @map("ip_address")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  config              CollegePaymentConfig    @relation(fields: [configId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([collegeId, createdAt(sort: Desc)], map: "idx_payment_config_audits")
  @@map("college_payment_config_audits")
}

model PaymentTransaction {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId             String                   @map("college_id") @db.Uuid
  eventId               String                   @map("event_id") @db.Uuid
  reservationId         String?                  @unique @map("reservation_id") @db.Uuid
  participantType       ParticipantType          @map("participant_type")
  userId                String?                  @map("user_id") @db.Uuid
  externalParticipantId String?                  @map("external_participant_id") @db.Uuid
  amount                Int
  currency              String                   @default("INR")
  status                TransactionPaymentStatus @default(PENDING)
  gatewayProvider       PaymentGatewayProvider   @default(RAZORPAY) @map("gateway_provider")
  paymentMode           CollegePaymentMode       @map("payment_mode")
  merchantAccountId     String?                  @map("merchant_account_id")
  gatewayOrderId        String?                  @unique @map("gateway_order_id")
  gatewayPaymentId      String?                  @unique @map("gateway_payment_id")
  gatewaySignature      String?                  @map("gateway_signature")
  paymentMethod         String?                  @map("payment_method")
  vpaMasked             String?                  @map("vpa_masked")
  idempotencyKey        String                   @unique @map("idempotency_key")
  registrationPayload   Json?                    @map("registration_payload")
  failureReason         String?                  @map("failure_reason")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  college               College                  @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  event                 Event                    @relation(fields: [collegeId, eventId], references: [collegeId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payment_transactions_event")
  reservation           SeatReservation?         @relation(fields: [collegeId, reservationId], references: [collegeId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payment_transactions_reservation")
  user                  User?                    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  externalParticipant   ExternalParticipant?     @relation(fields: [collegeId, externalParticipantId], references: [collegeId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payment_transactions_external_participant")
  registration          EventRegistration?
  refunds               PaymentRefund[]

  @@unique([collegeId, id], map: "uq_payment_transactions_college_id")
  @@unique([collegeId, reservationId], map: "uq_payment_transactions_college_reservation")
  @@index([collegeId, eventId], map: "idx_payment_transactions_event")
  @@index([gatewayOrderId], map: "idx_payment_transactions_order")
  @@index([collegeId, userId, createdAt(sort: Desc)], map: "idx_payment_transactions_college_user")
  @@index([collegeId, status], map: "idx_payment_transactions_college_status")
  @@map("payment_transactions")
}

model PaymentRefund {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId      String       @map("transaction_id") @db.Uuid
  collegeId          String       @map("college_id") @db.Uuid
  gatewayRefundId    String?      @unique @map("gateway_refund_id")
  amount             Int
  status             RefundStatus @default(INITIATED)
  reason             String?
  initiatedByAdminId String?      @map("initiated_by_admin_id") @db.Uuid
  idempotencyKey     String?      @map("idempotency_key")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction        PaymentTransaction @relation(fields: [collegeId, transactionId], references: [collegeId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_payment_refunds_transaction")
  college            College            @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([collegeId, idempotencyKey], map: "uq_payment_refunds_college_idempotency")
  @@index([collegeId, transactionId], map: "idx_payment_refunds_college_txn")
  @@map("payment_refunds")
}

model PaymentWebhookEvent {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId      String?                @map("college_id") @db.Uuid
  provider       PaymentGatewayProvider
  gatewayEventId String                 @map("gateway_event_id")
  eventType      String                 @map("event_type")
  payload        Json
  status         WebhookProcessStatus   @default(RECEIVED)
  errorMessage   String?                @map("error_message")
  claimToken     String?                @map("claim_token")
  processedAt    DateTime?              @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  college        College?               @relation(fields: [collegeId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([provider, gatewayEventId], map: "uq_payment_webhooks_provider_event")
  @@index([collegeId, createdAt(sort: Desc)], map: "idx_payment_webhooks_college")
  @@index([status, createdAt], map: "idx_payment_webhooks_status")
  @@map("payment_webhook_events")
}

model ExternalAuthOtp {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collegeId   String    @map("college_id") @db.Uuid
  email       String    @db.Citext
  salt        String    @db.VarChar(32)
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  college     College   @relation(fields: [collegeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email, collegeId, consumedAt, expiresAt], map: "idx_external_otps_candidate")
  @@map("external_auth_otps")
}

