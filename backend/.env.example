# Local development bypasses rate limits. Production deployments must set this to "production" or rate limits will not apply.
NODE_ENV=development

# Add your Brevo API key locally and in Render's environment settings.
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=4 THE PEOPLE

# FRONTEND_URL is used to build links in emails; keep it to one frontend URL.
FRONTEND_URL=http://localhost:5173
# Add the exact origins allowed to call the API, separated by commas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required only when running `node seed.js`.
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# ─── Phase 3: External Participant OTP & Outbox Worker ───────────────────────
# Dedicated pepper for external participant OTP hashing.
# MUST NOT be the same value as ACTIVATION_CODE_PEPPER.
# Minimum 32 bytes (UTF-8). Never hardcode. Required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTERNAL_OTP_PEPPER=replace-with-a-strong-random-secret-min-32-bytes

# 32-byte secret for encrypting outbox payload (AES-256-GCM). Required in production.
OUTBOX_ENCRYPTION_KEY=replace-with-a-strong-random-secret-min-32-bytes

# Dedicated connection URL for the email outbox worker (role: yuva_outbox_worker).
# Falls back to DATABASE_URL if not provided.
# OUTBOX_WORKER_DATABASE_URL=postgresql://yuva_outbox_worker:password@host/db?schema=public

# Optional: Run outbox worker in-process within the Express server (set to "true").
# For high traffic, run as a dedicated process: `npm run worker:outbox`.
ENABLE_IN_PROCESS_OUTBOX_WORKER=false

# Optional Outbox worker tuning
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=120
OUTBOX_REAPER_INTERVAL_MS=60000
